# Supabase (proyecto conectado vía MCP en opencode.json)
NEXT_PUBLIC_SUPABASE_URL=https://tu-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# URL pública del sitio (para metadataBase y URLs absolutas en Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Solo necesario para ejecutar la migración desde el MCP / SQL Editor
# (no lo uses en el código del cliente)
SUPABASE_ACCESS_TOKEN=tu-personal-access-token

# Clave service_role (SOLO servidor, nunca NEXT_PUBLIC_).
# Necesaria para el dashboard /admin (listar usuarios y CRUD con RLS omitido).
# Cópiala desde Supabase Dashboard → Project Settings → API.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
